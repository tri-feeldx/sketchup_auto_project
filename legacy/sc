# HELPER FUNCTIONS
# ═══════════════════════════════════════════════════════════════════════════════

def _extract_json(text: str) -> str | None:
    """Extract JSON from LLM response."""
    text = text.strip()
    # Remove markdown code fences
    if text.startswith("```"):
        lines = text.split("\n")
        if lines[0].startswith("```"):
            lines = lines[1:]
        if lines and lines[-1].strip().startswith("```") or lines[-1].strip() == "```":
            lines = lines[:-1]
        text = "\n".join(lines)
    
    try:
        json.loads(text)
        return text
    except (json.JSONDecodeError, ValueError):
        # Try to find JSON object in text
        match = re.search(r'\{.*\}', text, re.DOTALL)
        if match:
            try:
                json.loads(match.group())
                return match.group()
            except json.JSONDecodeError:
                pass
        return None


def _build_model_from_analyses(plan_analyses, elevation_analyses, section_analyses) -> dict:
    """Build unified building model from per-page analyses."""
    
    floors = []
    for i, pa in enumerate(plan_analyses):
        floor_info = pa.get("floor_level", {})
        
        # Convert columns to standardized format
        columns = []
        for col in pa.get("columns", []):
            columns.append({
                "mark": col.get("mark", f"C{len(columns)+1}"),
                "grid_x": col.get("grid_x", 0),
                "grid_y": col.get("grid_y", 0),
                "grid_label": col.get("grid_label", ""),
                "x_mm": col.get("position_mm", {}).get("x", 0),
                "y_mm": col.get("position_mm", {}).get("y", 0),
                "z_start_mm": floor_info.get("elevation_z_mm", i * 3500),
                "z_end_mm": floor_info.get("elevation_z_mm", i * 3500) + floor_info.get("floor_height_mm", 3500),
                "section_label": col.get("section_label", "400x400"),
                "section_width_mm": col.get("section_width_mm", 400),
                "section_depth_mm": col.get("section_depth_mm", 400),
                "material": col.get("material", "Concrete"),
                "confidence": col.get("confidence", 0.8),
            })
        
        # Convert beams to standardized format
        beams = []
        for beam in pa.get("beams", []):
            gx1, gy1 = beam.get("grid_x_start", 0), beam.get("grid_y_start", 0)
            gx2, gy2 = beam.get("grid_x_end", 1), beam.get("grid_y_end", 0)
            length_mm = beam.get("length_mm", 6000)
            if not length_mm:
                # Estimate from grid spacing
                length_mm = abs(gx2 - gx1) * 6000 if abs(gx2 - gx1) > 0 else abs(gy2 - gy1) * 5000
            
            beams.append({
                "mark": beam.get("mark", f"B{len(beams)+1}"),
                "grid_x": gx1, "grid_y": gy1,
                "grid_x2": gx2, "grid_y2": gy2,
                "x_mm": gx1 * 6000, "y_mm": gy1 * 5000,
                "x2_mm": gx2 * 6000, "y2_mm": gy2 * 5000,
                "z_start_mm": floor_info.get("elevation_z_mm", i * 3500) + floor_info.get("floor_height_mm", 3500) - 400,
                "z_end_mm": floor_info.get("elevation_z_mm", i * 3500) + floor_info.get("floor_height_mm", 3500),
                "section_label": beam.get("section_label", "UB305x165x40"),
                "material": beam.get("material", "Steel"),
                "length_mm": length_mm,
                "confidence": beam.get("confidence", 0.8),
            })
        
        # Walls
        walls = []
        for wall in pa.get("walls", []):
            gx1, gy1 = wall.get("grid_x_start", 0), wall.get("grid_y_start", 0)
            gx2, gy2 = wall.get("grid_x_end", 1), wall.get("grid_y_end", 0)
            length_mm = wall.get("length_mm", abs(gx2 - gx1) * 6000 + abs(gy2 - gy1) * 5000)
            
            walls.append({
                "mark": wall.get("mark", f"W{len(walls)+1}"),
                "grid_x": gx1, "grid_y": gy1,
                "grid_x2": gx2, "grid_y2": gy2,
                "x_mm": gx1 * 6000, "y_mm": gy1 * 5000,
                "x2_mm": gx2 * 6000, "y2_mm": gy2 * 5000,
                "z_start_mm": floor_info.get("elevation_z_mm", i * 3500),
                "z_end_mm": floor_info.get("elevation_z_mm", i * 3500) + floor_info.get("floor_height_mm", 3500),
                "thickness_mm": wall.get("thickness_mm", 200),
                "type": wall.get("type", "brick"),
                "is_structural": wall.get("is_structural", False),
                "confidence": wall.get("confidence", 0.8),
            })
        
        floor_data = {
            "floor_index": i,
            "name": floor_info.get("name", f"Floor {i}"),
            "elevation_z_mm": floor_info.get("elevation_z_mm", i * 3500),
            "floor_height_mm": floor_info.get("floor_height_mm", 3500),
            "columns": columns,
            "beams": beams,
            "walls": walls,
            "arch_doors": pa.get("doors", []),
            "arch_windows": pa.get("windows", []),
            "arch_stairs": pa.get("stairs", []),
            "arch_slabs": pa.get("slabs", []),
            "grid_system": pa.get("grid_system", {"detected": False}),
            "building_outline": pa.get("building_outline", {}),
        }
        floors.append(floor_data)
    
    # Extract grid system from first plan
    grid_x = {"labels": [], "spacings_mm": []}
    grid_y = {"labels": [], "spacings_mm": []}
    if plan_analyses:
        gs = plan_analyses[0].get("grid_system", {})
        if gs.get("detected"):
            grid_x = {"labels": gs.get("grid_x_labels", []), "spacings_mm": gs.get("spacing_x_mm", [])}
            grid_y = {"labels": gs.get("grid_y_labels", []), "spacings_mm": gs.get("spacing_y_mm", [])}
    
    # Extract roof from elevation
    roof = {"type": "flat", "eaves_z_mm": 3500, "ridge_z_mm": 5500}
    if elevation_analyses:
        elev = elevation_analyses[0]
        roof = elev.get("roof", roof)
    
    # Calculate total height
    total_height_mm = floors[-1]["elevation_z_mm"] + floors[-1]["floor_height_mm"] if floors else 3500
    
    building_name = "Building"
    for pa in plan_analyses:
        if pa.get("floor_level", {}).get("name"):
            building_name = pa["floor_level"]["name"].replace(" Floor", "").replace(" Plan", "")
    
    return {
        "building_name": building_name,
        "building_type": "mixed",
        "num_floors": len(floors),
        "total_height_mm": total_height_mm,
        "grid_x": grid_x,
        "grid_y": grid_y,
        "scale_x_mm_per_px": 3.0,
        "scale_confidence": 0.7,
        "floors": floors,
        "roof": roof,
        "levels": [
            {
                "name": f["name"],
                "elevation_mm": f["elevation_z_mm"],
                "floor_height_mm": f["floor_height_mm"],
                "plan_page_index": f.get("plan_page_index", i),
            }
            for i, f in enumerate(floors)
        ],
        "plan_page_indices": list(range(len(floors))),
        "elevation_page_indices": [],
        "schedule_page_indices": [],
        "member_db": {},
        "wall_types": [],
        "door_types": [],
        "window_types": [],
        "building_outline": floors[0].get("building_outline", {}) if floors else {},
        "page_classifications": {},
        "num_pages": len(floors),
        "pdf_type": "structural-architectural",
        "version": "v5-vision-first",
    }


