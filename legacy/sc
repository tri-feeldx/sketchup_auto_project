# SCANNER V5 CLASS
# ═══════════════════════════════════════════════════════════════════════════════

class ScannerV5:
    """
    Vision-first scanner that sends PDF page images directly to Gemini Vision.
    
    Pipeline:
    1. Render PDF → high-res PNG images (300 DPI)
    2. Classify each page (plan/elevation/section/schedule)
    3. Analyze each page with type-specific prompt
    4. Synthesize multi-floor data into unified building model
    """
    
    def __init__(self, pdf_path: str | Path, dpi: int = 300):
        self.pdf_path = Path(pdf_path)
        self.dpi = dpi
        self.renderer = None
        self.page_images = []       # List[PIL.Image]
        self.page_classifications = []  # List[dict]
        self.page_analyses = []     # List[dict] — per-page analysis results
        self.building_model = None  # Final synthesized model
        
    def run(self) -> dict:
        """Execute full V5 scanning pipeline."""
        print("\n" + "=" * 70)
        print("SCANNER V5 — Vision-First Analysis")
        print("=" * 70)
        
        # Phase 1: Render
        print("\n[1/4] Rendering PDF pages...")
        self._render_pages()
        print(f"  → Rendered {len(self.page_images)} pages @ {self.dpi} DPI")
        
        # Phase 2: Classify
        print("\n[2/4] Classifying pages...")
        self._classify_pages()
        for i, c in enumerate(self.page_classifications):
            print(f"  Page {i}: {c.get('page_type', '?')} | {c.get('description', '')[:60]}")
        
        # Phase 3: Analyze each page
        print("\n[3/4] Analyzing pages...")
        self._analyze_pages()
        
        # Phase 4: Synthesize
        print("\n[4/4] Synthesizing multi-floor model...")
        self._synthesize_model()
        print(f"  → Building: {self.building_model.get('building_name', '?')}")
        print(f"  → Floors: {self.building_model.get('num_floors', '?')}")
        print(f"  → Total height: {self.building_model.get('total_height_mm', '?')}mm")
        
        return self.building_model
    
    def _render_pages(self):
        """Render all PDF pages as PIL Images."""
        self.renderer = VisionRenderer(self.pdf_path, self.dpi)
        self.page_images = []
        for i in range(self.renderer.num_pages):
            img = self.renderer.render_page_as_pil(i)
            self.page_images.append(img)
    
    def _classify_pages(self):
        """Classify each page type using Gemini Vision."""
        self.page_classifications = []
        
        for i, img in enumerate(self.page_images):
            print(f"  Classifying page {i+1}/{len(self.page_images)}...")
            try:
                response = call_llm(
                    PAGE_CLASSIFY_PROMPT,
                    image_parts=[img],
                    retries=3,
                    retry_delay=5.0,
                )
                data = _extract_json(response)
                if data:
                    classification = json.loads(data)
                else:
                    classification = {"page_type": "unknown", "confidence": 0.0}
            except Exception as e:
                print(f"    [WARN] Classification error page {i}: {e}")
                classification = {"page_type": "unknown", "confidence": 0.0, "error": str(e)}
            
            classification["page_index"] = i
            self.page_classifications.append(classification)
    
    def _analyze_pages(self):
        """Analyze each page with type-specific prompt."""
        self.page_analyses = []
        
        for i, (img, classification) in enumerate(zip(self.page_images, self.page_classifications)):
            page_type = classification.get("page_type", "unknown")
            print(f"  Analyzing page {i} [{page_type}]...")
            
            if page_type == "plan":
                analysis = self._analyze_floor_plan(img, i)
            elif page_type == "elevation":
                analysis = self._analyze_elevation(img, i)
            elif page_type == "section":
                analysis = self._analyze_section(img, i)
            elif page_type in ("schedule", "detail", "title_block", "other", "unknown"):
                analysis = {"page_type": page_type, "analysis": "not_processed"}
            else:
                analysis = {"page_type": page_type, "analysis": "not_processed"}
            
            analysis["page_index"] = i
            analysis["page_type"] = page_type
            self.page_analyses.append(analysis)
    
    def _analyze_floor_plan(self, img, page_idx: int) -> dict:
        """Analyze a floor plan image with the full structural+architectural prompt."""
        prompt = FLOOR_PLAN_PROMPT.format(DRAWING_RULES=DRAWING_CONVENTIONS)
        
        try:
            response = call_llm(
                prompt,
                image_parts=[img],
                retries=3,
                retry_delay=10.0,
            )
            data = _extract_json(response)
            if data:
                plan_data = json.loads(data)
                # Ensure all required keys exist
                plan_data.setdefault("columns", [])
                plan_data.setdefault("beams", [])
                plan_data.setdefault("walls", [])
                plan_data.setdefault("doors", [])
                plan_data.setdefault("windows", [])
                plan_data.setdefault("stairs", [])
                plan_data.setdefault("slabs", [])
                plan_data.setdefault("grid_system", {"detected": False})
                plan_data.setdefault("building_outline", {})
                plan_data.setdefault("floor_level", {})
                return plan_data
        except Exception as e:
            print(f"    [ERROR] Floor plan analysis: {e}")
        
        return {"error": "analysis_failed", "columns": [], "beams": [], "walls": [],
                "doors": [], "windows": [], "stairs": [], "slabs": []}
    
    def _analyze_elevation(self, img, page_idx: int) -> dict:
        """Analyze an elevation drawing."""
        prompt = ELEVATION_PROMPT.format(DRAWING_RULES=DRAWING_CONVENTIONS)
        
        try:
            response = call_llm(prompt, image_parts=[img], retries=3, retry_delay=10.0)
            data = _extract_json(response)
            if data:
                return json.loads(data)
        except Exception as e:
            print(f"    [ERROR] Elevation analysis: {e}")
        
        return {"error": "analysis_failed"}
    
    def _analyze_section(self, img, page_idx: int) -> dict:
        """Analyze a section drawing."""
        prompt = SECTION_PROMPT.format(DRAWING_RULES=DRAWING_CONVENTIONS)
        
        try:
            response = call_llm(prompt, image_parts=[img], retries=3, retry_delay=10.0)
            data = _extract_json(response)
            if data:
                return json.loads(data)
        except Exception as e:
            print(f"    [ERROR] Section analysis: {e}")
        
        return {"error": "analysis_failed"}
    
    def _synthesize_model(self):
        """Synthesize all page analyses into unified building model."""
        plan_analyses = [a for a in self.page_analyses if a.get("page_type") == "plan"]
        elevation_analyses = [a for a in self.page_analyses if a.get("page_type") == "elevation"]
        section_analyses = [a for a in self.page_analyses if a.get("page_type") == "section"]
        
        # If multiple plan pages, assume each is a different floor
        if len(plan_analyses) >= 2:
            self._synthesize_multi_floor(plan_analyses, elevation_analyses, section_analyses)
        elif len(plan_analyses) == 1:
            self._synthesize_single_floor(plan_analyses[0], elevation_analyses, section_analyses)
        else:
            # Fallback: no plan pages detected
            self.building_model = _empty_model()
    
    def _synthesize_multi_floor(self, plan_analyses, elevation_analyses, section_analyses):
        """Synthesize multi-floor building model."""
        # Use multi-floor synthesis prompt
        floors_summary = []
        for i, pa in enumerate(plan_analyses):
            floor_info = pa.get("floor_level", {})
            floors_summary.append({
                "floor_index": i,
                "name": floor_info.get("name", f"Floor {i}"),
                "elevation_z_mm": floor_info.get("elevation_z_mm", i * 3500),
                "floor_height_mm": floor_info.get("floor_height_mm", 3500),
                "num_columns": len(pa.get("columns", [])),
                "num_beams": len(pa.get("beams", [])),
                "num_walls": len(pa.get("walls", [])),
                "num_doors": len(pa.get("doors", [])),
                "num_windows": len(pa.get("windows", [])),
            })
        
        # Build model directly from plan analyses
        self.building_model = _build_model_from_analyses(
            plan_analyses, elevation_analyses, section_analyses
        )
    
    def _synthesize_single_floor(self, plan_analysis, elevation_analyses, section_analyses):
        """Single floor building model."""
        self.building_model = _build_model_from_analyses(
            [plan_analysis], elevation_analyses, section_analyses
        )
    
    def close(self):
        if self.renderer:
            self.renderer.close()
    
    def __enter__(self):
        return self
    
    def __exit__(self, *args):
        self.close()


