# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
venv/
.venv/
env/

# Environment
.env
*.env

# Google Cloud Service Account keys — NEVER commit credentials
river-bedrock-*.json
data/output_json/
data/llm_cache/

# Output files — generated artifacts, never commit
output/

# Data files (PDFs, large files)
data/**/*.pdf
data/**/*.dwg
data/**/*.ifc
*.pdf
*.dwg
*.ifc

# IDE — track settings.json + extensions.json, ignore everything else
.vscode/launch.json
.vscode/tasks.json
.vscode/*.code-snippets
.idea/
*.swp
*.swo

# Temporary editor swap files (Claude Code / VSCode edits)
*.tmp.*
*.tmp

# CodeGraph local index (rebuild on new machine: npx @colbymchenry/codegraph init && npx @colbymchenry/codegraph index)
.codegraph/

# Ruby tools
.rubocop_cache/
.bundle/

# OS
.DS_Store
Thumbs.db
