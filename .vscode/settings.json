{
  // ── Python (pipeline) ──────────────────────────────────────────────────────
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoImportCompletions": true,
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true
  },

  // ── Ruby / SketchUp extension (generated .rb scripts) ─────────────────────
  "ruby.rake.autoDetect": "off",
  "solargraph.diagnostics": true,
  "solargraph.formatting": false,
  "[ruby]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "misogi.ruby-rubocop"
  },

  // ── Editor: general ───────────────────────────────────────────────────────
  "editor.rulers": [100],
  "editor.trimAutoWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  // ── File associations ──────────────────────────────────────────────────────
  "files.associations": {
    "*.rb": "ruby",
    "*.gemspec": "ruby",
    "Gemfile": "ruby",
    "Rakefile": "ruby",
    "*.md": "markdown"
  },

  // ── Spell checker ─────────────────────────────────────────────────────────
  "cSpell.words": [
    "Commonmarker",
    "Feeldx",
    "Gemfile",
    "LOD300",
    "LOD350",
    "LOD400",
    "Minh",
    "RuboCop",
    "Solargraph",
    "SketchUp",
    "Synthesizer",
    "Tamworth",
    "Vertex",
    "asnzs",
    "extractor",
    "synthesizer"
  ]
}
